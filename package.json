  "main": "packages/core/src/index.js",
  "type": "module",
  "exports": {
    ".": "./packages/core/src/index.js",
    "./server": "./packages/server/src/index.js",
    "./agent": "./packages/agent-sdk/src/index.js"
  },
  "files": [
    "packages/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
